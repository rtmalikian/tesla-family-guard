# Tesla Fleet API application credentials (developer.tesla.com)
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=<redacted>
TESLA_REGION=na
TESLA_REDIRECT_URI=http://localhost:8080/callback

# Your vehicles: name=VIN pairs, comma-separated
TFG_VEHICLES=Model Y=YOUR_VIN_HERE,Model 3=SECOND_VIN_HERE

# The OpenAI-compatible server THIS app exposes
TFG_SERVER_HOST=127.0.0.1
TFG_SERVER_PORT=8647
# Optional: require Authorization: Bearer <key> on /v1/* (recommended if exposed on LAN)
TFG_SERVER_API_KEY=<redacted>
TFG_MODEL_ID=tesla-family-guard

# Pluggable LLM backend — any OpenAI-compatible API. Default: local Ollama.
# The app works FULLY without a backend (rules engine); the LLM only explains
# the weekly report card in free-form words. Vehicle data is sent only to
# this backend — nowhere else. This app never commands a car.
TFG_AI_BASE_URL=http://localhost:11434/v1
TFG_AI_API_KEY=<redacted>
TFG_AI_MODEL=llama3.1
# auto = rules first, LLM for the rest | always = LLM first | never = rules only
TFG_AI_MODE=auto
TFG_AI_TIMEOUT_SECONDS=20

TFG_EMBEDDING_DIM=384
TFG_TOKEN_FILE=~/.tfg/tokens.json
# 1 = report actions instead of sending them
TFG_DRY_RUN=0

# Family-guard rules — plain words, set by `tfguard setup`
TFG_SPEED_LIMIT_MPH=75
TFG_CURFEW_START=11:00 PM
TFG_CURFEW_END=5:00 AM
TFG_QUIET_START=10:00 PM
TFG_QUIET_END=7:00 AM
TFG_ALERT_COOLDOWN_MINUTES=60
# Your private ntfy.sh topic (install the ntfy app, subscribe to this topic)
TFG_NTFY_TOPIC=
# Allowed areas: name|street address|lat,lon,radius_miles, separated by ';'
# (written by `tfguard setup`, which geocodes the address for you)
TFG_GEOFENCES=
TFG_DATA_FILE=~/.tfg/drives.jsonl
